:root {
    --option-panel-color: rgb(242, 241, 237);
    --option-surface-color: rgb(250, 249, 245);
    --option-hover-color: rgb(220, 219, 215);
    --option-active-color: rgb(142, 141, 137);
    --option-line-color: rgb(48, 48, 46);
    --option-line-width: 5px;
}

.option-menu-canvas {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
}

.option-menu-panel {
    width: 780px;
    height: 900px;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    background-color: var(--option-panel-color);
    border-top-width: var(--option-line-width);
    border-right-width: var(--option-line-width);
    border-bottom-width: var(--option-line-width);
    border-left-width: var(--option-line-width);
    border-top-color: var(--option-line-color);
    border-right-color: var(--option-line-color);
    border-bottom-color: var(--option-line-color);
    border-left-color: var(--option-line-color);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
}

.option-title-label {
    width: 660px;
    height: 100px;
    color: var(--option-line-color);
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.option-setting-group {
    width: 660px;
    height: 650px;
    flex-direction: column;
    justify-content: space-between;
}

.option-setting-area {
    width: 660px;
    height: 140px;
    padding-top: 0;
    padding-right: 30px;
    padding-bottom: 0;
    padding-left: 30px;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    color: var(--option-line-color);
    background-color: var(--option-surface-color);
    border-top-width: var(--option-line-width);
    border-right-width: var(--option-line-width);
    border-bottom-width: var(--option-line-width);
    border-left-width: var(--option-line-width);
    border-top-color: var(--option-line-color);
    border-right-color: var(--option-line-color);
    border-bottom-color: var(--option-line-color);
    border-left-color: var(--option-line-color);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
}

.option-description-label {
    height: 80px;
    color: var(--option-line-color);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.sound-control-area {
    width: 330px;
    height: 70px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.sound-direction-label {
    width: 30px;
    height: 50px;
    color: var(--option-line-color);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sound-slider {
    width: 250px;
    height: 70px;
    flex-shrink: 0;
}

.sound-slider .unity-base-slider__tracker {
    height: 12px;
    background-color: var(--option-hover-color);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.sound-slider .unity-base-slider__dragger {
    width: 30px;
    height: 30px;
    background-color: var(--option-active-color);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.help-state-button {
    width: 100px;
    height: 60px;
    min-width: 100px;
    min-height: 60px;
    max-width: 100px;
    max-height: 60px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--option-active-color);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--option-line-color);
    border-right-color: var(--option-line-color);
    border-bottom-color: var(--option-line-color);
    border-left-color: var(--option-line-color);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.help-state-button:hover {
    background-color: var(--option-hover-color);
}

.help-state-button:active {
    background-color: var(--option-line-color);
}

.help-state-label {
    width: 96px;
    height: 56px;
    color: var(--option-surface-color);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.return-button {
    width: 660px;
    height: 140px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    color: var(--option-line-color);
    background-color: var(--option-surface-color);
    border-top-width: var(--option-line-width);
    border-right-width: var(--option-line-width);
    border-bottom-width: var(--option-line-width);
    border-left-width: var(--option-line-width);
    border-top-color: var(--option-line-color);
    border-right-color: var(--option-line-color);
    border-bottom-color: var(--option-line-color);
    border-left-color: var(--option-line-color);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.return-button:hover {
    background-color: var(--option-hover-color);
}

.return-button:active {
    color: var(--option-surface-color);
    background-color: var(--option-active-color);
}
