<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/07.UI_Toolkit/USS/MainMenu/MainMenu.uss"/>
    <ui:VisualElement name="main-menu-canvas" class="main-menu-canvas">
        <ui:VisualElement name="main-menu-content" class="main-menu-content">
            <ui:Label name="sudoku-title-label" text="SUDOKU" class="sudoku-title-label"/>
            <ui:VisualElement name="main-menu-button-group" class="main-menu-button-group">
                <ui:Button name="game-start-button" text="Game Start" class="main-menu-button"/>
                <ui:Button name="option-button" text="Option" class="main-menu-button"/>
                <ui:Button name="exit-button" text="Exit" class="main-menu-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
